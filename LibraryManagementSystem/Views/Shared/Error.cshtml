@model LibraryManagementSystem.Models.ErrorViewModel
@{ ViewData["Title"] = "Error"; }

<section class="auth-section">
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="auth-card">
                    <div class="auth-icon" style="background:linear-gradient(135deg,#ef4444,#dc2626);">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <h1 class="auth-title mt-3">An Error Occurred</h1>
                    <p class="auth-subtitle">Something went wrong while processing your request.</p>
                    @if (Model?.ShowRequestId ?? false)
                    {
                        <p class="small text-muted mt-2">Request ID: <code>@Model.RequestId</code></p>
                    }
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                        <i class="bi bi-house me-1"></i>Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
