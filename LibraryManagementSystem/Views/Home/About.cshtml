@{ ViewData["Title"] = "About"; }

<section class="dashboard-section" style="padding-top: 3rem;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center mb-5">
                    <span class="section-badge">About</span>
                    <h1 class="section-title">About Our Library</h1>
                    <p class="section-subtitle">Empowering readers with technology</p>
                </div>
                <div class="auth-card">
                    <h3><i class="bi bi-building me-2"></i>Our Mission</h3>
                    <p class="text-muted">
                        The Library Management System is designed to streamline library operations,
                        making it easier for members to discover and borrow books, and for
                        administrators to manage the entire library ecosystem efficiently.
                    </p>
                    <hr />
                    <h3><i class="bi bi-gear me-2"></i>Technology Stack</h3>
                    <ul class="text-muted">
                        <li><strong>Backend:</strong> ASP.NET MVC (.NET 8) with C#</li>
                        <li><strong>Database:</strong> SQL Server with Entity Framework Core (Code First)</li>
                        <li><strong>Security:</strong> BCrypt password hashing, Anti-forgery tokens</li>
                        <li><strong>Frontend:</strong> Bootstrap 5, Bootstrap Icons, Google Fonts</li>
                    </ul>
                    <hr />
                    <h3><i class="bi bi-people me-2"></i>Contact</h3>
                    <p class="text-muted mb-0">
                        For questions or support, please contact the library administration team.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
