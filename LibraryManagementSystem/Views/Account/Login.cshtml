@model LoginViewModel
@{ ViewData["Title"] = "Login"; }

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="auth-card">
                    <div class="auth-header">
                        <div class="auth-icon"><i class="bi bi-box-arrow-in-right"></i></div>
                        <h1 class="auth-title">Welcome Back</h1>
                        <p class="auth-subtitle">Sign in to access your library account</p>
                    </div>
                    <form asp-action="Login" asp-controller="Account" method="post" class="auth-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" id="loginEmail" placeholder="Email" autocomplete="email" />
                            <label asp-for="Email"><i class="bi bi-envelope me-1"></i>Email Address</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="form-floating mb-4">
                            <input asp-for="Password" class="form-control" id="loginPassword" placeholder="Password" autocomplete="current-password" />
                            <label asp-for="Password"><i class="bi bi-lock me-1"></i>Password</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 auth-submit-btn" id="loginSubmitBtn">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </button>
                    </form>
                    <div class="demo-credentials">
                        <p class="mb-1"><strong><i class="bi bi-info-circle me-1"></i>Demo Admin:</strong></p>
                        <p class="mb-0 small">Email: <code>admin&#64;library.com</code> | Password: <code>Admin&#64;123</code></p>
                    </div>
                    <div class="auth-footer">
                        <p>Don't have an account? <a asp-controller="Account" asp-action="Register" class="auth-link">Create one <i class="bi bi-arrow-right"></i></a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
