@* =============================================================================
    Register.cshtml - Registration Page
    Library Management System
    =============================================================================
    User registration form with:
      - Full Name, Email, Password, Confirm Password fields
      - Client-side and server-side validation via Data Annotations
      - Anti-forgery token for CSRF protection
      - Link to login page for existing users
    ============================================================================= *@

@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="auth-card">
                    <!-- Header -->
                    <div class="auth-header">
                        <div class="auth-icon">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>
                        <h1 class="auth-title">Create Account</h1>
                        <p class="auth-subtitle">Join our library community today</p>
                    </div>

                    <!-- Registration Form -->
                    <form asp-action="Register" asp-controller="Account" method="post" class="auth-form">
                        @Html.AntiForgeryToken()

                        <!-- Validation Summary (shows general errors) -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Full Name Field -->
                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control" id="registerName"
                                   placeholder="Full Name" autocomplete="name" />
                            <label asp-for="Name">
                                <i class="bi bi-person me-1"></i>Full Name
                            </label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Email Field -->
                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" id="registerEmail"
                                   placeholder="Email Address" autocomplete="email" />
                            <label asp-for="Email">
                                <i class="bi bi-envelope me-1"></i>Email Address
                            </label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Password Field -->
                        <div class="form-floating mb-3">
                            <input asp-for="Password" class="form-control" id="registerPassword"
                                   placeholder="Password" autocomplete="new-password" />
                            <label asp-for="Password">
                                <i class="bi bi-lock me-1"></i>Password
                            </label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password Field -->
                        <div class="form-floating mb-3">
                            <input asp-for="ConfirmPassword" class="form-control" id="registerConfirmPassword"
                                   placeholder="Confirm Password" autocomplete="new-password" />
                            <label asp-for="ConfirmPassword">
                                <i class="bi bi-lock-fill me-1"></i>Confirm Password
                            </label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary w-100 auth-submit-btn" id="registerSubmitBtn">
                            <i class="bi bi-person-plus me-2"></i>Create Account
                        </button>
                    </form>

                    <!-- Login Link -->
                    <div class="auth-footer">
                        <p>
                            Already have an account?
                            <a asp-controller="Account" asp-action="Login" class="auth-link">
                                Sign in here <i class="bi bi-arrow-right"></i>
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @* Client-side validation scripts *@
    <partial name="_ValidationScriptsPartial" />
}
